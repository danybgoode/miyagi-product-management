#!/bin/sh
# Local-first pre-push gate — BLOCKING, budgeted at UNDER 30 SECONDS. Auto-enabled via
# package.json's "prepare" script (git config core.hooksPath .githooks).
#
# ── Why this hook exists at all ──────────────────────────────────────────────────────────────────
# `guards.yml` is PR-triggered, and this repo commits **direct to main** for low-risk doc/tooling
# work. That path never opens a PR, so before this hook existed the only gate on it was pre-commit —
# which is why pre-commit had accreted the entire test suite and two full-corpus walks, and why a
# commit took ~2 minutes.
#
# Splitting it fixes both halves: commits stay instant (staged files only), and the whole-repo
# checks move here, where they run a few times a day instead of many times an hour. `guards.yml`
# also gained a `push: [main]` trigger so direct-to-main still gets the full asynchronous CI run —
# this hook is the fast local answer, not the last line of defence.
#
# ── What belongs here ────────────────────────────────────────────────────────────────────────────
# Cheap whole-repo checks. NOT the corpus-walking integration tests (`*.itest.mjs`) — those spawn a
# full ~860-doc extraction each and belong in CI. Run them on demand with:
#     node --test 'scripts/*.itest.mjs'
#
# Path-gated throughout: a push that didn't touch scripts/ pays nothing for the script tests.
#
# Bypass with `git push --no-verify` if you genuinely need to.

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found — skipping local guards (CI still applies)." >&2
  exit 0
fi

# What is actually being pushed — read from git, not guessed from HEAD.
#
# git feeds a pre-push hook one line per ref on STDIN: "<local ref> <local sha> <remote ref>
# <remote sha>". This hook used to ignore that entirely and derive its scope from the CURRENT BRANCH
# (`@{upstream}...HEAD`, falling back to `origin/main...HEAD`, then to `HEAD~1...HEAD`). For an
# ordinary `git push` of the checked-out branch those agree, so the bug stayed invisible.
#
# They do NOT agree when the pushed ref is not the checked-out branch. `scripts/lib/log-branch.mjs`
# pushes append-only log commits by plumbing — `git push origin <sha>:refs/heads/claude/<log>` — for
# the session journal, the standup, the weekly recap and the PMO reports. Those commits contain one
# flat log file and share no ancestry with the working tree, but the hook measured `HEAD~1...HEAD` of
# `main` instead. So a Roadmap-touching commit on main made the hook run `build-order --check`
# against the WORKING TREE, and a stale board — including one caused by another agent's UNTRACKED
# file in this shared checkout — blocked the journal push.
#
# That failure mode was the worst possible one: `session-note.mjs` fails soft by design (a log must
# never break the work it records), so the journal silently stopped recording the one thing that
# cannot be re-derived later — intent. Observed 2026-08-25.
#
# Reading stdin fixes the general case, not just log branches: every push is now gated on the paths
# it actually carries. Deletions (local sha all-zero) contribute nothing. A brand-new remote ref
# (remote sha all-zero) has no range, so it falls back to `origin/main...<local sha>`.
#
# If stdin is empty or unreadable (a manual invocation, or a git that passes nothing), we fall back
# to the old HEAD-derived scope rather than checking nothing — a hook that cannot determine scope
# must not silently pass, and must not block either.
zero=0000000000000000000000000000000000000000
stdin_seen=0
changed=''
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  stdin_seen=1
  [ "$local_sha" = "$zero" ] && continue                      # branch deletion — carries no paths
  if [ "$remote_sha" = "$zero" ] || [ -z "$remote_sha" ]; then
    range=$(git diff --name-only "origin/main...$local_sha" 2>/dev/null)
  else
    range=$(git diff --name-only "$remote_sha...$local_sha" 2>/dev/null)
  fi
  changed=$(printf '%s\n%s' "$changed" "$range")
done

if [ "$stdin_seen" -eq 0 ]; then
  remote_head=$(git rev-parse --verify --quiet '@{upstream}' 2>/dev/null)
  if [ -n "$remote_head" ]; then
    changed=$(git diff --name-only "$remote_head"...HEAD 2>/dev/null)
  else
    changed=$(git diff --name-only origin/main...HEAD 2>/dev/null)
  fi
  [ -z "$changed" ] && changed=$(git diff --name-only HEAD~1...HEAD 2>/dev/null)
fi

fail=0

# ── scripts/ — the PURE node:test suite (~0.6s for 37 files, run in parallel) ────────────────────
# Deliberately globs *.test.mjs only. The two integration files are named *.itest.mjs precisely so
# this line can exclude them by pattern rather than by an exclusion list that would rot.
if echo "$changed" | grep -qE '^scripts/'; then
  echo "pre-push: scripts/ unit tests..." >&2
  if ! node --test 'scripts/lib/*.test.mjs' 'scripts/*.test.mjs'; then
    echo "pre-push: scripts/ node:test failed — see output above." >&2
    fail=1
  fi
fi

# ── infra/ — deploy invariants ───────────────────────────────────────────────────────────────────
if echo "$changed" | grep -qE '^infra/'; then
  echo "pre-push: infra/ deploy-invariant tests..." >&2
  if ! node --test 'infra/gcp/test/*.test.js' 'infra/gcp/test/*.test.mjs'; then
    echo "pre-push: infra/ node:test failed — see output above." >&2
    fail=1
  fi
fi

# ── Roadmap/ — the derived board must not be stale ───────────────────────────────────────────────
# One corpus walk, and the most expensive thing in this hook — hence path-gated to Roadmap-touching
# pushes only. It cannot self-heal here the way pre-commit and CI can (the commit is already made),
# so it reports and blocks with the exact fix rather than rewriting history.
if echo "$changed" | grep -qE '^(Roadmap/|scripts/(build-order|roadmap-to-notion)\.mjs)'; then
  echo "pre-push: build-order freshness..." >&2
  if ! node scripts/build-order.mjs --check >/dev/null 2>&1; then
    echo "pre-push: BUILD-ORDER.md is STALE — it is DERIVED, never hand-edited." >&2
    echo "          Run:  node scripts/build-order.mjs" >&2
    echo "          Then: git add Roadmap/00-ideas/BUILD-ORDER.md && git commit --amend --no-edit" >&2
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-push: failed. Fix and re-push, or 'git push --no-verify' to bypass." >&2
  exit 1
fi

exit 0
