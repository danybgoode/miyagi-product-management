#!/bin/sh
# post-checkout — fire the prose merge report after a git operation that brought new commits.
#
# This is a LOCAL, best-effort trigger for scripts/merge-report.mjs. The authoritative trigger is
# now .github/workflows/merge-report.yml, which fires on push to main in the app repos and does not
# depend on anyone pulling. This hook survives as the path that still works offline and on a repo
# without the workflow — but it is no longer the only way a merge gets reported, which is the point:
# a hook only fires on the machine that PULLS, so a squash-merge nobody pulled was never reported.
#
# Over-triggering is safe and deliberate: the hook fires on every merge-y git operation, including a
# pull that fetched nothing. merge-report.mjs owns the once-per-commit guarantee via its state file
# and exits silently when there is nothing new, so a noisy hook cannot produce a noisy channel.
#
# Backgrounded and always-true: a prose report must NEVER slow down or fail a git operation.
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
script="$root/scripts/merge-report.mjs"
# App repos have no scripts/ of their own — they borrow the root repo's copy.
[ -f "$script" ] || script="$root/../../scripts/merge-report.mjs"
[ -f "$script" ] || exit 0
# The log goes in the COMMON git dir, not "$root/.git": in a linked worktree `.git` is a FILE, so
# the old path made every redirect fail with "Not a directory" and the hook died before running the
# script at all. Silently — the whole thing is backgrounded. This repo runs several worktrees at a
# time, so that was a large share of the reports that never appeared. (Fixed 2026-07-27.)
gitdir="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
case "$gitdir" in /*) ;; *) gitdir="$root/$gitdir" ;; esac
( cd "$root" && node "$script" >>"$gitdir/merge-report.log" 2>&1 || true ) &
exit 0
